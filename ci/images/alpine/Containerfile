# lazy-bootstrap build image - Alpine, one flavour per toolchain.
#
#   podman build -f ci/images/alpine/Containerfile \
#       --build-arg BASE=docker.io/library/alpine:3.22 \
#       --build-arg TOOLCHAIN_KIND=filc --build-arg TOOLCHAIN_VERSION=0.681 \
#       -t lazy-bootstrap/alpine:filc-0.681 ci
#
# Context is `ci/`, see ci/images/debian/Containerfile for why (D-24).

ARG BASE=docker.io/library/alpine:latest
FROM ${BASE}

ARG TOOLCHAIN_KIND=gcc
ARG TOOLCHAIN_VERSION=""
ARG PROVISION="distro,binary"
# `libc6-compat` (gcompat) is a glibc *shim*: the image stays musl, so Fil-C
# still gets its musl build. Set to 1 for the "alpine + libc6-compat" target.
ARG WITH_LIBC6_COMPAT=0

LABEL org.opencontainers.image.title="lazy-bootstrap builder" \
      io.lazy-bootstrap.toolchain.kind="${TOOLCHAIN_KIND}" \
      io.lazy-bootstrap.toolchain.version="${TOOLCHAIN_VERSION}" \
      io.lazy-bootstrap.provision="${PROVISION}" \
      io.lazy-bootstrap.libc6-compat="${WITH_LIBC6_COMPAT}"

# Step 1: declared dependencies, common plus this flavour's.
COPY system-deps/alpine/ /opt/lazy-bootstrap/system-deps/
RUN set -eux; \
    pkgs="$(cat /opt/lazy-bootstrap/system-deps/common.txt \
                /opt/lazy-bootstrap/system-deps/${TOOLCHAIN_KIND}.txt 2>/dev/null \
            | sed 's/#.*//' | tr -s ' \n' '\n' | grep -v '^$' | sort -u | tr '\n' ' ')"; \
    echo "installing: $pkgs"; \
    apk add --no-cache $pkgs

RUN if [ "${WITH_LIBC6_COMPAT}" = "1" ]; then apk add --no-cache libc6-compat; fi

# Step 2: abuild needs a non-root user and a signing key.
RUN set -eux; \
    adduser -D -G abuild builder 2>/dev/null || true; \
    printf '\n' | abuild-keygen -a -i -n

# Step 3: the toolchain.
COPY images/alpine/install-toolchain.sh /opt/lazy-bootstrap/install-toolchain.sh
RUN sh /opt/lazy-bootstrap/install-toolchain.sh "${TOOLCHAIN_KIND}" "${TOOLCHAIN_VERSION}" "${PROVISION}"

WORKDIR /build
