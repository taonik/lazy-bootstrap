# A caching reverse proxy for Alpine packages and for source tarballs.
#
# apk has no apt-cacher-ng equivalent, and source tarballs are not a package
# format at all, so both are handled the same way: a plain HTTP cache in front
# of the upstream, keyed by path.
#
# The split of cache lifetimes below is the whole point. An .apk or a release
# tarball at a given version is immutable and can be kept until the disk is
# needed; APKINDEX changes whenever the repository does, and serving a stale
# one produces "package not found" for packages that plainly exist - a failure
# that reads as a broken mirror rather than a stale cache.

FROM nginx:1.27-alpine

RUN apk add --no-cache ca-certificates

COPY <<'CONF' /etc/nginx/conf.d/default.conf
proxy_cache_path /var/cache/lb-http
                 levels=1:2
                 keys_zone=lbcache:64m
                 max_size=20g
                 inactive=90d
                 use_temp_path=off;

# Resolving at request time, not at startup: a DNS blip while this container
# starts must not pin a dead address for its whole lifetime.
resolver 1.1.1.1 8.8.8.8 valid=300s ipv6=off;

map $uri $lb_cache_time {
    default              30d;   # .apk, .tar.*, anything version-stamped
    ~*APKINDEX\.tar\.gz$  2m;   # repository index - must not go stale
    ~*/InRelease$         2m;
    ~*/Release$           2m;
    ~*/Packages(\.\w+)?$  2m;
}

server {
    listen 8080;
    server_name _;

    # Large tarballs stream straight through rather than being buffered whole
    # in memory before the client sees a byte.
    proxy_http_version 1.1;
    proxy_buffering    on;
    proxy_read_timeout 300s;

    proxy_cache             lbcache;
    proxy_cache_valid       200 206 $lb_cache_time;
    proxy_cache_valid       404 1m;
    proxy_cache_key         "$scheme$request_method$host$request_uri";
    # One upstream fetch for N simultaneous identical requests: with 16 build
    # environments starting together this is the difference between one
    # download and sixteen.
    proxy_cache_lock        on;
    proxy_cache_lock_timeout 120s;
    # A cached copy is better than a failed build when upstream wobbles.
    proxy_cache_use_stale   error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    add_header X-LB-Cache   $upstream_cache_status always;

    location /alpine/ {
        proxy_pass https://dl-cdn.alpinelinux.org/alpine/;
        proxy_set_header Host dl-cdn.alpinelinux.org;
    }

    location /distfiles/ {
        proxy_pass https://distfiles.alpinelinux.org/distfiles/;
        proxy_set_header Host distfiles.alpinelinux.org;
    }

    location /debian/ {
        proxy_pass https://deb.debian.org/debian/;
        proxy_set_header Host deb.debian.org;
    }

    location /debian-security/ {
        proxy_pass https://deb.debian.org/debian-security/;
        proxy_set_header Host deb.debian.org;
    }

    location = /lb-health {
        access_log off;
        return 200 "ok\n";
    }
}
CONF

VOLUME /var/cache/lb-http
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=3s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/lb-health || exit 1
